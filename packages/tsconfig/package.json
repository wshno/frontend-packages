{
  "name": "@wshno/tsconfig",
  "version": "0.1.1",
  "description": "Shared TypeScript base configs: base, React Router (Vite), Node",
  "license": "MIT",
  "author": "Hans Christian Winther-Sørensen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wshno/frontend-packages.git",
    "directory": "packages/tsconfig"
