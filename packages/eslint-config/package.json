{
  "name": "@wshno/eslint-config",
  "version": "0.2.0",
  "description": "Shared ESLint flat config: JavaScript and TypeScript recommended, SonarJS, React (@eslint-react), React Refresh, plus Vitest, Testing Library and Playwright presets",
  "license": "MIT",
  "author": "Hans Christian Winther-Sørensen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wshno/frontend-packages.git",
    "directory": "packages/eslint-config"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
